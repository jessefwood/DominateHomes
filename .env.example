# Database. Railway supplies this via ${{Postgres.DATABASE_URL}} in production.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME"

# The public base URL. Sign-in links are built from it, so a wrong value here
# means links that do not work. Required in production.
APP_URL="http://localhost:3000"

# Sending sign-in emails. Leave both unset in development and links are printed
# to the server console instead. Both are required in production.
RESEND_API_KEY=""
MAIL_FROM="Dominate Homes <info@dominatehomes.com>"

# Encrypts third party credentials (Stripe, Resend) before they are stored.
# Generate with: openssl rand -base64 32
# Changing it makes every stored credential unreadable, so they would need
# pasting in again. Required before anything can be connected in admin.
CREDENTIAL_KEY=""

# File storage. Any S3-compatible bucket: Railway, Cloudflare R2, Backblaze,
# S3 itself. Leave all four unset and the portal works exactly as it does
# without storage, except that the Files section says sending files is not
# switched on yet.
#
# THE BUCKET MUST BE PRIVATE. Nothing in it is read by URL. Every download
# goes through /api/files/<id>, which checks who is asking and then redirects
# to a link that expires in ten minutes. A public bucket would make all of
# that pointless.
S3_BUCKET=""
S3_KEY=""
S3_SECRET=""
# No trailing slash. Railway: https://storage.railway.app
S3_ENDPOINT=""
# "auto" suits Railway and R2. S3 itself wants its real region, e.g. us-east-1.
S3_REGION="auto"

# The way back in. Comma separated addresses that can always get a sign-in
# link, and that get a designer account whether or not one exists.
#
# Who is a designer is still decided by User.role in the database, which is
# what every access check reads and what admin edits. This is a safety net for
# the one failure that has no recovery: there is no password here and no
# self-signup, so both designer accounts being closed by accident would
# otherwise mean a database session to get back in. It only ever adds access,
# never removes it. Set it to both of your addresses.
ADMIN_EMAILS=""

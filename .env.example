# Database. Railway supplies this via ${{Postgres.DATABASE_URL}} in production.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME"

# The public base URL. Sign-in links are built from it, so a wrong value here
# means links that do not work. Required in production.
APP_URL="http://localhost:3000"

# Sending sign-in emails. Leave both unset in development and links are printed
# to the server console instead. Both are required in production.
RESEND_API_KEY=""
MAIL_FROM="Dominate Homes <info@dominatehomes.com>"

# Encrypts third party credentials (Stripe, Resend) before they are stored.
# Generate with: openssl rand -base64 32
# Changing it makes every stored credential unreadable, so they would need
# pasting in again. Required before anything can be connected in admin.
CREDENTIAL_KEY=""
